# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must NEVER be committed to version control.

# Flask — change SECRET_KEY in every environment that is not your local machine
SECRET_KEY=change-me-in-production

# IBM watsonx.ai — required to enable AI features
# Without these three values the app runs in rule-based fallback mode (fully functional).
#
# How to obtain:
#   API key:    IBM Cloud > Manage > Access > API keys > Create
#   Project ID: watsonx.ai Studio > your project > Manage > General
#   URL:        region-specific endpoint (examples below)
#
# Region endpoints:
#   Dallas (us-south):  https://us-south.ml.cloud.ibm.com   <- granite-4-h-small available here
#   Frankfurt (eu-de):  https://eu-de.ml.cloud.ibm.com      <- granite-4-h-small available here
#   London (eu-gb):     https://eu-gb.ml.cloud.ibm.com      <- embeddings only; use Frankfurt for chat
#   Tokyo (jp-tok):     https://jp-tok.ml.cloud.ibm.com     <- embeddings only; use Dallas for chat
WATSONX_API_KEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model IDs — verified non-deprecated defaults as of Nov 2026.
# granite-4-h-small:                multitenant, Dallas + Frankfurt regions only
# granite-embedding-278m-multilingual: multitenant, 7 regions incl. Dallas, Frankfurt, London
# Consult https://cloud.ibm.com/docs/watsonx-ai before changing these.
WATSONX_CHAT_MODEL=ibm/granite-4-h-small
WATSONX_EMBED_MODEL=ibm/granite-embedding-278m-multilingual

# Timeout in seconds for each watsonx.ai API call (default: 30)
# Timeouts return None immediately to the caller; the background thread may
# continue running briefly until the SDK resolves or errors on its own.
WATSONX_TIMEOUT_SECONDS=30

# Pricing reference (IBM Cloud documented rates as of Nov 2026 — verify current rates
# at https://cloud.ibm.com/catalog/services/watsonxai-runtime before budgeting):
#   granite-4-h-small input:   Class 18 x $0.0001 base = $0.0018 per 1,000 input tokens
#   granite-4-h-small output:  Class 5  x $0.0001 base = $0.0005 per 1,000 output tokens
#   granite-embedding-278m:    Class C1 (see IBM Cloud catalog for current C1 rate)
#   Lite plan:                 300,000 tokens/month free, 2 requests/second rate limit
#   Actual costs depend on your prompt lengths and usage volume.
